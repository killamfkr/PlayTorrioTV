<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sourceItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="@android:color/transparent"
    android:focusable="true"
    android:gravity="center_vertical">

    <View
        android:id="@+id/sourceAccentBar"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="#9C27B0"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sourceProviderLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VidLink"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sourceQualityLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="1080p"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/sourceLoadingSpinner"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:indeterminateTint="#9C27B0"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sourceCheckmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✓"
        android:textColor="#9C27B0"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="invisible" />
</LinearLayout>
